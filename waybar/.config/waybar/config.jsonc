{
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "height": 32,
  "modules-left": ["custom/launcher", "hyprland/workspaces", "cpu", "battery"],
  "modules-center": ["clock"],
  "modules-right": ["bluetooth", "pulseaudio", "network", "custom/power"],

  // Custom -- Arch
  "custom/launcher": {
    "format": "󰣇",
    "tooltip": true,
    "tooltip-format": "Soham's Arch",
    "on-click": "alacritty -e neofetch"
  },

  // Custom - Power [Might be changed to wlogout]
  "custom/power": {
    "format": " ",
    "on-click": "bash ~/.config/rofi/leave/leave.sh"
  },

  // CPU
  "cpu": {
    "format": " {usage}%"
  },

  // Memory
  

  // Clock
  "clock": {
    "format": " {:%H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}\n{:%H:%M:%S}",
    "on-click": "gnome-calendar",
    "interval": 1
  },

  // hyprland workspaces
  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "disable-scroll": false,
    "format-icons": {
      "active": "",
      "default": ""
    },
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": []
    },
    "sort-by-number": true
  }
}
