{
  "position": "top",
  "layer": "top",
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,
  "modules-left": ["custom/launcher", "hyprland/workspaces", "backlight"],
  "modules-center": ["clock"],
  "modules-right": [
    "pulseaudio",
    "bluetooth",
    "network",
    "backlight",
    "battery",
    "custom/power"
  ],

  // Custom -- Arch
  "custom/launcher": {
    "format": "󰣇",
    "tooltip": true,
    "tooltip-format": "Soham's Arch"
    // "on-click": "bash ~/.config/rofi/leave/leave.sh"
  },

  // // Custom - Power [Might be changed to wlogout]
  "custom/power": {
    "format": " ",
    "on-click": "bash ~/.config/rofi/leave/leave.sh"
  },

  // Apps
  "custom/app": {
    "format": "Apps",
    "on-click": "rofi -show drun"
  },

  // Battery
  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "{capacity}% ",
    "format-plugged": "{capacity}% ",
    "format-alt": "{icon} {time}",
    "format-icons": ["", "", "", "", ""]
  },

  // Clock
  "clock": {
    "format": "{:%H:%M}",
    "tooltip": "true",
    "on-click": "gnome-calendar",
    "interval": 5
  },

  // hyprland workspaces
  "hyprland/workspaces": {
    "active-only": false,
    "all-outputs": true,
    "disable-scroll": false,
    "on-scroll-up": "hyprctl dispatch workspace -1",
    "on-scroll-down": "hyprctl dispatch workspace +1",
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": {
      "urgent": "",
      "active": "",
      "default": "󰧞",
      "sort-by-number": true
    }
  }
}
