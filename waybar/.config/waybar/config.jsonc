{
  "layer": "top",
  "position": "top",
  "spacing": 5,
  "height": 24,
  "margin-top": 8,
  "margin-right": 8,
  "margin-bottom": 0,
  "margin-left": 8,

  "modules-left": ["custom/launcher", "hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [
    "bluetooth",
    "pulseaudio",
    "cpu",
    "battery",
    "temperature",
    "custom/power"
  ],

  "custom/launcher": {
    "format": "󰣇",
    "tooltip": true,
    "tooltip-format": "btw"
  },

  "custom/power": {
    "format": " ",
    "on-click": "bash ~/.config/rofi/leave/leave.sh"
  },

  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}  {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{time} {icon}",
    "format-icons": ["", "", "", "", ""]
  },

  "clock": {
    "format": "{: %I:%M %p   %d/%m/%Y}"
  },

  "cpu": {
    "interval": 15,
    "format": " {}%",
    "max-length": 10
  }
}
