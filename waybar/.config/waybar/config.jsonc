{
  "layer": "top",
  "position": "top",
  "height": 10,
  "margin-top": 0,
  "margin-bottom": 0,

  "modules-left": ["custom/launcher", "hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [
    "tray",
    "bluetooth",
    "pulseaudio",
    "battery",
    "custom/power"
  ],

  "custom/launcher": {
    "format": "󰣇",
    "tooltip": true,
    "tooltip-format": "Soham's Arch"
  },

  "custom/power": {
    "format": " ",
    "on-click": "bash ~/.config/rofi/leave/leave.sh"
  },

  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}  {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{time} {icon}",
    "format-icons": ["", "", "", "", ""]
  },

  "clock": {
    "format-alt": "{:%H:%M}",
    "format": "{:%d %B %Y - %I:%M %p}",
    "on-click": "gnome-calendar",
    "interval": 60
  },

  "cpu": {
    "interval": 15,
    "format": "  {}%",
    "on-click": "alacritty -e 'htop'"
  },

  "network": {
    "format-wifi": "{essid} ({signalStrength}%) ",
    "format-ethernet": "{ifname} ",
    "format-disconnected": "",
    "max-length": 50,
    "on-click": "kitty -e 'nmtui'"
  },

  "memory": {
    "interval": 10,
    "format": " {used}MB/{total}MB"
  },

  "hyprland/workspaces": {
    "on-click": "activate",
    "sort-by-name": true
  }
}
